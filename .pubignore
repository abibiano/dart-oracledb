# Reference implementations (node-oracledb, python-oracledb) — dev only
reference/

# BMAD planning and output artifacts
_bmad/
_bmad-output/

# Release scripts — not needed by package consumers
scripts/

# Local dev tooling
docker-compose.yml
docker-compose.override.yml
coverage/

# Generated dartdoc output. Gitignored, but a root .pubignore shadows the root
# .gitignore, so it must be repeated here or a local `dart doc` run leaks 200+
# HTML files into the published archive (pub.dev renders API docs itself).
doc/api/

# TLS test certificates (gitignored *.pem)
docker/tls/
